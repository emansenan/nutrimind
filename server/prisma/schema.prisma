// This is your Prisma schema file for the MicroMind Base SAAS Template
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  role            UserRole  @default(USER)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  sessions        Session[]
  dashboards      Dashboard[]
  reports         Report[]
  
  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// ANALYTICS & REPORTING
// ============================================================================

model Dashboard {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  sqlQuery    String?  @db.Text
  chartConfig Json?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isPublic])
  @@map("dashboards")
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  content     Json?
  format      String   @default("PDF")
  s3Path      String?
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@map("reports")
}

// ============================================================================
// DOCUMENT MANAGEMENT
// ============================================================================

model Document {
  id          String       @id @default(uuid())
  title       String
  description String?
  fileType    DocumentType
  s3Path      String
  size        Int?
  uploadedBy  String?
  tags        String[]     @default([])
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([fileType])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("documents")
}

// ============================================================================
// AI SERVICES
// ============================================================================

model ChatHistory {
  id          String   @id @default(uuid())
  userId      String?
  agentType   String
  message     String   @db.Text
  response    String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([agentType])
  @@index([createdAt])
  @@map("chat_history")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum DocumentType {
  PDF
  IMAGE
  VIDEO
  AUDIO
  SPREADSHEET
  DOCUMENT
  OTHER
}
